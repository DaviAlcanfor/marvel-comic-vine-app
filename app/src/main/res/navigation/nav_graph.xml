<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.projeto.marvel.ui.login.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.projeto.marvel.ui.home.HomeFragment"
        android:label="Personagens">
        <action
            android:id="@+id/action_home_to_detail"
            app:destination="@id/characterDetailFragment" />
        <action
            android:id="@+id/action_home_to_teams"
            app:destination="@id/teamsFragment" />
    </fragment>

    <fragment
        android:id="@+id/characterDetailFragment"
        android:name="com.projeto.marvel.ui.detail.CharacterDetailFragment"
        android:label="Detalhe">
        <argument
            android:name="apiDetailUrl"
            app:argType="string" />
        <argument
            android:name="characterName"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/teamsFragment"
        android:name="com.projeto.marvel.ui.teams.TeamsFragment"
        android:label="Times" />

</navigation>
