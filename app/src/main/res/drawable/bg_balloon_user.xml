<?xml version="1.0" encoding="utf-8"?>
<!-- Balão do fã no chat: dourado do tema. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="?attr/eraShadow"
        android:top="?attr/eraShadow">
        <shape>
            <solid android:color="@color/ink" />
            <corners android:radius="@dimen/balloon_radius" />
        </shape>
    </item>
    <item
        android:bottom="?attr/eraShadow"
        android:right="?attr/eraShadow">
        <shape>
            <solid android:color="@color/accent" />
            <stroke
                android:width="?attr/eraInkWidth"
                android:color="?attr/eraOutline" />
            <corners android:radius="@dimen/balloon_radius" />
        </shape>
    </item>
</layer-list>
