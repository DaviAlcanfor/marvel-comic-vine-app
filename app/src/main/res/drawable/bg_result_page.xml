<?xml version="1.0" encoding="utf-8"?>
<!-- Página de HQ do resultado: papel, retícula por cima, contorno de nanquim grosso e sombra dura. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="6dp"
        android:top="6dp">
        <shape>
            <solid android:color="@color/ink" />
            <corners android:radius="@dimen/radius_small" />
        </shape>
    </item>
    <item
        android:bottom="6dp"
        android:right="6dp">
        <shape>
            <solid android:color="@color/comic_paper" />
            <stroke
                android:width="3dp"
                android:color="@color/ink" />
            <corners android:radius="@dimen/radius_small" />
        </shape>
    </item>
    <item
        android:bottom="6dp"
        android:drawable="@drawable/bg_halftone"
        android:right="6dp" />
</layer-list>
