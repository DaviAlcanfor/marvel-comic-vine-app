<?xml version="1.0" encoding="utf-8"?>
<!-- Caixa de narração de HQ ("Enquanto isso..."): papel amarelado com contorno de nanquim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="?attr/eraShadow"
        android:top="?attr/eraShadow">
        <shape>
            <solid android:color="@color/primary_variant" />
        </shape>
    </item>
    <item
        android:bottom="?attr/eraShadow"
        android:right="?attr/eraShadow">
        <shape>
            <solid android:color="@color/paper" />
            <stroke
                android:width="?attr/eraInkWidth"
                android:color="?attr/eraOutline" />
        </shape>
    </item>
</layer-list>
