<?xml version="1.0" encoding="utf-8"?>
<!-- Página de HQ das missões: papel da superfície, contorno grosso e sombra dura (os quadros
     ficam dentro, separados pela sarjeta). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="?attr/eraShadow"
        android:top="?attr/eraShadow">
        <shape>
            <solid android:color="@color/primary_variant" />
            <corners android:radius="?attr/eraRadiusSmall" />
        </shape>
    </item>
    <item
        android:bottom="?attr/eraShadow"
        android:right="?attr/eraShadow">
        <shape>
            <solid android:color="@color/surface" />
            <stroke
                android:width="3dp"
                android:color="?attr/eraOutline" />
            <corners android:radius="?attr/eraRadiusSmall" />
        </shape>
    </item>
</layer-list>
