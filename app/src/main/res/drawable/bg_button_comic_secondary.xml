<?xml version="1.0" encoding="utf-8"?>
<!-- Botão de HQ: sombra dura deslocada; pressionado, a face "afunda" por cima da sombra. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item
                android:bottom="@dimen/hard_shadow"
                android:right="@dimen/hard_shadow">
                <shape>
                    <solid android:color="@color/surface_variant" />
                    <stroke
                        android:width="@dimen/ink_width"
                        android:color="@color/ink" />
                    <corners android:radius="@dimen/space_xs" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item
                android:left="@dimen/hard_shadow"
                android:top="@dimen/hard_shadow">
                <shape>
                    <solid android:color="@color/surface" />
                    <stroke
                        android:width="@dimen/ink_width"
                        android:color="@color/accent" />
                    <corners android:radius="@dimen/space_xs" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:left="@dimen/hard_shadow"
                android:top="@dimen/hard_shadow">
                <shape>
                    <solid android:color="@color/ink" />
                    <corners android:radius="@dimen/space_xs" />
                </shape>
            </item>
            <item
                android:bottom="@dimen/hard_shadow"
                android:right="@dimen/hard_shadow">
                <shape>
                    <solid android:color="@color/surface" />
                    <stroke
                        android:width="@dimen/ink_width"
                        android:color="@color/accent" />
                    <corners android:radius="@dimen/space_xs" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
