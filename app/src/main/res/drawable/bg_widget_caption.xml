<?xml version="1.0" encoding="utf-8"?>
<!-- Cópia fixa do bg_caption para o widget (roda no launcher, sem os ?attr de época). Caixa de legenda de HQ ("Enquanto isso..."): dourado, contorno de nanquim e sombra dura. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="@dimen/hard_shadow"
        android:top="@dimen/hard_shadow">
        <shape>
            <solid android:color="@color/ink" />
        </shape>
    </item>
    <item
        android:bottom="@dimen/hard_shadow"
        android:right="@dimen/hard_shadow">
        <shape>
            <solid android:color="@color/accent" />
            <stroke
                android:width="@dimen/ink_width"
                android:color="@color/ink" />
        </shape>
    </item>
</layer-list>
