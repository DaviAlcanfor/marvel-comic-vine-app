<?xml version="1.0" encoding="utf-8"?>
<!-- Anel de adesivo POR CIMA da foto (foreground): contorno de nanquim e borda branca. Por cima e
     não como fundo + padding, senão a foto quadrada aparece com os cantos dentro do círculo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="?attr/eraInkWidth"
                android:color="?attr/eraOutline" />
        </shape>
    </item>
    <item
        android:bottom="?attr/eraInkWidth"
        android:left="?attr/eraInkWidth"
        android:right="?attr/eraInkWidth"
        android:top="?attr/eraInkWidth">
        <shape android:shape="oval">
            <stroke
                android:width="3dp"
                android:color="@color/white" />
        </shape>
    </item>
</layer-list>
