<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo como painel de HQ: contorno de nanquim, sombra dura vermelha (preta sumiria no scrim) e
     a retícula da época por cima do papel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="?attr/eraShadow"
        android:top="?attr/eraShadow">
        <shape>
            <solid android:color="@color/primary_variant" />
            <corners android:radius="?attr/eraRadius" />
        </shape>
    </item>
    <item
        android:bottom="?attr/eraShadow"
        android:right="?attr/eraShadow">
        <shape>
            <solid android:color="@color/surface" />
            <stroke
                android:width="?attr/eraInkWidth"
                android:color="?attr/eraOutline" />
            <corners android:radius="?attr/eraRadius" />
        </shape>
    </item>
    <item
        android:bottom="?attr/eraShadow"
        android:drawable="@drawable/bg_halftone"
        android:right="?attr/eraShadow" />
</layer-list>
