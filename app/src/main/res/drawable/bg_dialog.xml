<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo como painel de HQ: contorno de nanquim e sombra dura vermelha (preta sumiria no scrim). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="@dimen/hard_shadow"
        android:top="@dimen/hard_shadow">
        <shape>
            <solid android:color="@color/primary_variant" />
            <corners android:radius="@dimen/radius_large" />
        </shape>
    </item>
    <item
        android:bottom="@dimen/hard_shadow"
        android:right="@dimen/hard_shadow">
        <shape>
            <solid android:color="@color/surface" />
            <stroke
                android:width="@dimen/ink_width"
                android:color="@color/ink" />
            <corners android:radius="@dimen/radius_large" />
        </shape>
    </item>
</layer-list>
