<?xml version="1.0" encoding="utf-8"?>
<!-- Segue "Detalhe do Personagem.svg": avatar, nome, linha de números em dourado e seções Sobre/Poderes/Times. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <!-- Foto do personagem ampliada e desfocada como fundo (todo personagem tem foto; nem toda
         capa de HQ aparece sobre o fundo escuro). O degradê a dissolve no fundo da tela e é mais
         comprido que a foto: o desfoque espalha alguns pixels para fora dela, e sem essa sobra
         aparecia uma faixa colorida logo abaixo do degradê. -->
    <ImageView
        android:id="@+id/cover"
        android:layout_width="0dp"
        android:layout_height="@dimen/detail_cover_height"
        android:alpha="0.55"
        android:importantForAccessibility="no"
        android:scaleX="1.1"
        android:scaleY="1.1"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/detail_cover_fade_height"
        android:background="@drawable/bg_fade_to_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Retícula por cima da foto: o degradê termina na cor lisa do fundo, e sem isto as bolinhas
         do fundo da tela só começavam abaixo da foto (emenda visível). Mesma origem = alinhadas. -->
    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/detail_cover_fade_height"
        android:background="@drawable/bg_halftone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/backButton"
        style="@style/Widget.Material3.Button.TextButton.Icon"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/detail_back"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        app:icon="@drawable/ic_arrow_back"
        app:iconTint="@color/text_secondary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/backButton">

        <LinearLayout
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xl">

            <ImageView
                android:id="@+id/avatar"
                android:layout_width="@dimen/avatar_size_hero"
                android:layout_height="@dimen/avatar_size_hero"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_sticker"
                android:foreground="@drawable/fg_sticker_ring"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/name"
                style="@style/Widget.Marvel.H1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                tools:text="Spider-Man" />

            <!-- "Peter Parker · Human · Marvel" -->
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="Peter Parker · Human · Marvel" />

            <LinearLayout
                android:id="@+id/stats"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_card"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/space_md">

                <LinearLayout style="@style/Widget.Marvel.Stat">

                    <TextView
                        android:id="@+id/appearancesValue"
                        style="@style/Widget.Marvel.StatValue"
                        tools:text="1.643" />

                    <TextView
                        style="@style/Widget.Marvel.StatLabel"
                        android:text="@string/detail_stat_appearances" />
                </LinearLayout>

                <LinearLayout style="@style/Widget.Marvel.Stat">

                    <TextView
                        android:id="@+id/teamsValue"
                        style="@style/Widget.Marvel.StatValue"
                        tools:text="6" />

                    <TextView
                        style="@style/Widget.Marvel.StatLabel"
                        android:text="@string/detail_stat_teams" />
                </LinearLayout>

                <LinearLayout style="@style/Widget.Marvel.Stat">

                    <TextView
                        android:id="@+id/powersValue"
                        style="@style/Widget.Marvel.StatValue"
                        tools:text="12" />

                    <TextView
                        style="@style/Widget.Marvel.StatLabel"
                        android:text="@string/detail_stat_powers" />
                </LinearLayout>

            </LinearLayout>

            <!-- Abre o chat com a IA na persona do personagem. -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/chatButton"
                style="@style/Widget.Marvel.ComicButton"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_lg"
                android:visibility="gone" />

            <!-- Ações secundárias lado a lado (o Geek, acima, é a principal). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/photoButton"
                    style="@style/Widget.Marvel.ComicButton.Secondary"
                    android:layout_width="0dp"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:text="@string/detail_photo_short"
                    android:visibility="gone" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/compareButton"
                    style="@style/Widget.Marvel.ComicButton.Secondary"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:text="@string/detail_compare_short"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/aboutTitle"
                android:visibility="gone"
                style="@style/Widget.Marvel.CaptionBox"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/detail_section_about" />

            <TextView
                android:id="@+id/description"
                android:visibility="gone"
                style="@style/Widget.Marvel.Narration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm" />

            <!-- A bio vem em inglês: traduz (Gemini, com cache) e lê em voz alta (voz do Android). -->
            <LinearLayout
                android:id="@+id/bioActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/translateButton"
                    style="@style/Widget.Marvel.ComicButton.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/trade_button_height"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:text="@string/detail_translate"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/listenButton"
                    style="@style/Widget.Marvel.ComicButton.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/trade_button_height"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:text="@string/detail_listen"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/timelineTitle"
                android:visibility="gone"
                style="@style/Widget.Marvel.CaptionBox"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/detail_section_timeline" />

            <LinearLayout
                android:id="@+id/timelineList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/powersTitle"
                android:visibility="gone"
                style="@style/Widget.Marvel.CaptionBox"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/detail_section_powers" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/powersGroup"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:chipSpacingHorizontal="@dimen/space_sm"
                app:chipSpacingVertical="@dimen/space_sm" />

            <TextView
                android:id="@+id/teamsTitle"
                android:visibility="gone"
                style="@style/Widget.Marvel.CaptionBox"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/detail_section_teams" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/teamsGroup"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:chipSpacingHorizontal="@dimen/space_sm"
                app:chipSpacingVertical="@dimen/space_sm" />

            <!-- Curiosidades da Comic Vine: apelidos, estreia, "morreu em" (linhas montadas em código). -->
            <TextView
                android:id="@+id/factsTitle"
                android:visibility="gone"
                style="@style/Widget.Marvel.CaptionBox"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/detail_section_facts" />

            <TextView
                android:id="@+id/facts"
                style="@style/Widget.Marvel.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:visibility="gone" />

            <TextView
                android:id="@+id/creatorsTitle"
                android:visibility="gone"
                style="@style/Widget.Marvel.CaptionBox"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/detail_section_creators" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/creatorsList"
                style="@style/Widget.Marvel.Carousel"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <TextView
                android:id="@+id/moviesTitle"
                android:visibility="gone"
                style="@style/Widget.Marvel.CaptionBox"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/detail_section_movies" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/moviesList"
                style="@style/Widget.Marvel.Carousel"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <TextView
                android:id="@+id/firstIssueTitle"
                android:visibility="gone"
                style="@style/Widget.Marvel.CaptionBox"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/detail_section_first_issue" />

            <!-- Capa da primeira aparição (chega depois do resto, ver CharacterDetailViewModel). -->
            <LinearLayout
                android:id="@+id/firstIssue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/firstIssueCover"
                    android:layout_width="@dimen/first_issue_width"
                    android:layout_height="@dimen/first_issue_height"
                    android:background="@drawable/bg_card"
                    android:clipToOutline="true"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/firstIssueName"
                    style="@style/Widget.Marvel.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    tools:text="Amazing Fantasy #15" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_xl" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
