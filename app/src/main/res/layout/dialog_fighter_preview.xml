<?xml version="1.0" encoding="utf-8"?>
<!-- Ficha de lutador (seleção da Batalha): vida, atributos em barras, golpes e o botão de escolher. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="@dimen/space_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/image"
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:background="@drawable/bg_sticker"
            android:foreground="@drawable/fg_sticker_ring"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Texto comum (não o logotipo amarelo): a ficha é branca e o nome precisa ler. -->
            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="?attr/eraDisplayFont"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                app:fontFamily="?attr/eraDisplayFont"
                tools:text="Spider-Man" />

            <TextView
                android:id="@+id/hp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_heart"
                android:drawablePadding="@dimen/space_xs"
                android:gravity="center_vertical"
                android:textColor="@color/text_secondary"
                tools:text="Vida 124" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="@dimen/space_lg" />

    <TextView
        android:id="@+id/errorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/space_md"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <!-- Uma linha por atributo (rótulo, barra, valor), inflada em código. -->
    <LinearLayout
        android:id="@+id/stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="vertical" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/moves"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:importantForAccessibility="yes" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/chooseButton"
        style="@style/Widget.Marvel.ComicButton"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_lg"
        android:enabled="false"
        android:text="@string/battle_choose" />

</LinearLayout>
