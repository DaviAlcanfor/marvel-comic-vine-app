<?xml version="1.0" encoding="utf-8"?>
<!-- Um número do resumo da luta, no padrão dos números do Perfil: valor dourado em Bebas com o
     ícone ao lado e o rótulo embaixo. O contador sobe animado (BattleResult.kt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Marvel.Stat"
    android:paddingVertical="@dimen/space_sm">

    <TextView
        android:id="@+id/value"
        style="@style/Widget.Marvel.StatValue"
        android:drawablePadding="@dimen/space_xs"
        android:drawableTint="@color/text_secondary"
        android:gravity="center_vertical"
        tools:text="142" />

    <TextView
        android:id="@+id/label"
        style="@style/Widget.Marvel.StatLabel"
        android:gravity="center"
        tools:text="Dano causado" />
</LinearLayout>
