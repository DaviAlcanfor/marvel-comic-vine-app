<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:padding="@dimen/space_lg">

    <!-- Fundo da arena: linhas de ação de HQ (SpeedLinesDrawable, posto em código). -->
    <!-- Ringue 3D (OpenGL) atrás de tudo; as linhas de ação e os lutadores ficam por cima. -->
    <com.projeto.marvel.ui.battle.ArenaView
        android:id="@+id/arena3d"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@id/movesBarrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarrier" />

    <View
        android:id="@+id/arenaBackdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@id/movesBarrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarrier" />

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:background="@android:color/transparent"
        android:contentDescription="@string/content_description_back"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/title" />

    <TextView
        android:id="@+id/title"
        style="@style/Widget.Marvel.ScreenTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:text="@string/battle_title"
        app:layout_constraintEnd_toStartOf="@id/recordText"
        app:layout_constraintStart_toEndOf="@id/backButton"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Placar salvo no aparelho (SharedPreferences). -->
    <TextView
        android:id="@+id/recordText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingVertical="@dimen/space_xs"
        android:textColor="@color/background"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/title"
        tools:text="3V · 1D" />

    <!-- 2 jogadores: golpes do P2 em cima, virados para quem está do outro lado da mesa. -->
    <LinearLayout
        android:id="@+id/p2Moves"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:orientation="vertical"
        android:rotation="180"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/p2Ultimate"
            style="@style/Widget.Marvel.UltimateButton"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/p2Move1"
                style="@style/Widget.Marvel.MoveButton"
                android:layout_marginEnd="@dimen/space_xs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/p2Move2"
                style="@style/Widget.Marvel.MoveButton"
                android:layout_marginStart="@dimen/space_xs" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/p2Move3"
                style="@style/Widget.Marvel.MoveButton"
                android:layout_marginEnd="@dimen/space_xs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/p2Move4"
                style="@style/Widget.Marvel.MoveButton"
                android:layout_marginStart="@dimen/space_xs" />

        </LinearLayout>
    </LinearLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/topBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="title,p2Moves" />

    <!-- Adversário: canto superior esquerdo -->

    <ImageView
        android:id="@+id/cpuImage"
        android:layout_width="@dimen/fighter_size"
        android:layout_height="@dimen/fighter_size"
        android:layout_marginTop="@dimen/space_lg"
        android:background="@drawable/bg_sticker"
        android:padding="@dimen/space_xs"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarrier" />

    <TextView
        android:id="@+id/cpuPopup"
        style="@style/Widget.Marvel.BattlePopup"
        app:layout_constraintBottom_toBottomOf="@id/cpuImage"
        app:layout_constraintEnd_toEndOf="@id/cpuImage"
        app:layout_constraintStart_toStartOf="@id/cpuImage"
        app:layout_constraintTop_toTopOf="@id/cpuImage" />

    <TextView
        android:id="@+id/cpuName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cpuImage"
        app:layout_constraintTop_toTopOf="@id/cpuImage"
        tools:text="Iron Man" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/cpuHpBar"
        style="@style/Widget.Marvel.HpBar"
        app:layout_constraintEnd_toEndOf="@id/cpuName"
        app:layout_constraintStart_toStartOf="@id/cpuName"
        app:layout_constraintTop_toBottomOf="@id/cpuName" />

    <!-- Barra de energia da ultimate (enche com dano causado e recebido). -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/cpuEnergyBar"
        style="@style/Widget.Marvel.EnergyBar"
        app:layout_constraintEnd_toEndOf="@id/cpuName"
        app:layout_constraintStart_toStartOf="@id/cpuName"
        app:layout_constraintTop_toBottomOf="@id/cpuHpBar" />

    <TextView
        android:id="@+id/cpuHpText"
        android:drawableStart="@drawable/ic_heart"
        android:drawablePadding="@dimen/space_xs"
        android:gravity="center_vertical"
        style="@style/Widget.Marvel.BattleCaption"
        android:textColor="@color/text_secondary"
        app:layout_constraintStart_toStartOf="@id/cpuName"
        app:layout_constraintTop_toBottomOf="@id/cpuEnergyBar"
        tools:text="87/110" />

    <TextView
        android:id="@+id/cpuStatus"
        style="@style/Widget.Marvel.BattleCaption"
        android:textColor="@color/accent_text"
        app:layout_constraintStart_toStartOf="@id/cpuName"
        app:layout_constraintTop_toBottomOf="@id/cpuHpText"
        tools:text="Envenenado" />

    <!-- 3×3: o trio rival (ativo primeiro). -->
    <LinearLayout
        android:id="@+id/cpuSquad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/cpuName"
        app:layout_constraintTop_toBottomOf="@id/cpuStatus" />

    <!-- Narração do turno -->

    <TextView
        android:id="@+id/logText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_caption"
        android:gravity="center"
        android:minHeight="72dp"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:rotation="-1"
        android:textColor="@color/ink"
        android:textFontWeight="600"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@id/playerImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cpuImage"
        tools:text="Spider-Man usou Wall Crawling! −12" />

    <!-- Jogador: canto inferior direito -->

    <ImageView
        android:id="@+id/playerImage"
        android:layout_width="@dimen/fighter_size"
        android:layout_height="@dimen/fighter_size"
        android:layout_marginBottom="@dimen/space_lg"
        android:background="@drawable/bg_sticker"
        android:padding="@dimen/space_xs"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@id/movesBarrier"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/playerPopup"
        style="@style/Widget.Marvel.BattlePopup"
        app:layout_constraintBottom_toBottomOf="@id/playerImage"
        app:layout_constraintEnd_toEndOf="@id/playerImage"
        app:layout_constraintStart_toStartOf="@id/playerImage"
        app:layout_constraintTop_toTopOf="@id/playerImage" />

    <TextView
        android:id="@+id/playerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_md"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/playerImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/playerImage"
        tools:text="Spider-Man" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/playerHpBar"
        style="@style/Widget.Marvel.HpBar"
        app:layout_constraintEnd_toEndOf="@id/playerName"
        app:layout_constraintStart_toStartOf="@id/playerName"
        app:layout_constraintTop_toBottomOf="@id/playerName" />

    <!-- Barra de energia da ultimate (enche com dano causado e recebido). -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/playerEnergyBar"
        style="@style/Widget.Marvel.EnergyBar"
        app:layout_constraintEnd_toEndOf="@id/playerName"
        app:layout_constraintStart_toStartOf="@id/playerName"
        app:layout_constraintTop_toBottomOf="@id/playerHpBar" />

    <TextView
        android:id="@+id/playerHpText"
        android:drawableStart="@drawable/ic_heart"
        android:drawablePadding="@dimen/space_xs"
        android:gravity="center_vertical"
        style="@style/Widget.Marvel.BattleCaption"
        android:textColor="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="@id/playerName"
        app:layout_constraintTop_toBottomOf="@id/playerEnergyBar"
        tools:text="120/130" />

    <TextView
        android:id="@+id/playerStatus"
        style="@style/Widget.Marvel.BattleCaption"
        android:textColor="@color/accent_text"
        app:layout_constraintEnd_toEndOf="@id/playerName"
        app:layout_constraintTop_toBottomOf="@id/playerHpText"
        tools:text="Defendendo" />

    <!-- 3×3: o trio do jogador (ativo primeiro). -->
    <LinearLayout
        android:id="@+id/playerSquad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/playerName"
        app:layout_constraintTop_toBottomOf="@id/playerStatus" />

    <!-- Golpes (2x2) ou, no fim da luta, revanche -->

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/movesBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="moves,rematchButton" />

    <LinearLayout
        android:id="@+id/moves"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Aparece quando a barra de energia do jogador enche. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/ultimateButton"
            style="@style/Widget.Marvel.UltimateButton"
            android:visibility="gone" />

        <!-- 3×3: troca pelo próximo do trio (gasta a vez). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/swapButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/battle_swap"
            android:textAllCaps="false"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/move1"
                style="@style/Widget.Marvel.MoveButton"
                android:layout_marginEnd="@dimen/space_xs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/move2"
                style="@style/Widget.Marvel.MoveButton"
                android:layout_marginStart="@dimen/space_xs" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/move3"
                style="@style/Widget.Marvel.MoveButton"
                android:layout_marginEnd="@dimen/space_xs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/move4"
                style="@style/Widget.Marvel.MoveButton"
                android:layout_marginStart="@dimen/space_xs" />

        </LinearLayout>

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/rematchButton"
        style="@style/Widget.Marvel.ComicButton"
        android:layout_width="0dp"
        android:text="@string/battle_rematch"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Onomatopeias ("POW!") por cima de cada lutador, e o K.O. final no centro. -->
    <TextView
        android:id="@+id/cpuBurst"
        style="@style/Widget.Marvel.Onomatopoeia"
        app:layout_constraintBottom_toBottomOf="@id/cpuImage"
        app:layout_constraintStart_toStartOf="@id/cpuImage"
        app:layout_constraintTop_toTopOf="@id/cpuImage" />

    <TextView
        android:id="@+id/playerBurst"
        style="@style/Widget.Marvel.Onomatopoeia"
        app:layout_constraintBottom_toBottomOf="@id/playerImage"
        app:layout_constraintEnd_toEndOf="@id/playerImage"
        app:layout_constraintTop_toTopOf="@id/playerImage" />

    <TextView
        android:id="@+id/koBurst"
        style="@style/Widget.Marvel.Onomatopoeia"
        android:paddingHorizontal="48dp"
        android:paddingVertical="36dp"
        android:text="@string/battle_ko"
        android:textColor="@color/text_primary"
        android:textSize="64sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bola de energia da Rajada: posicionada e animada em código (fireProjectile). -->
    <View
        android:id="@+id/projectile"
        android:layout_width="@dimen/projectile_size"
        android:layout_height="@dimen/projectile_size"
        android:background="@drawable/bg_projectile"
        android:importantForAccessibility="no"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- "Quadro de impacto": pisca na cor do golpe por 2 quadros. Não recebe toque. -->
    <View
        android:id="@+id/impactFlash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="@color/primary"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Legenda de turno ("TURNO 3 · SUA VEZ!") que salta no meio da arena. -->
    <TextView
        android:id="@+id/turnBanner"
        style="@style/Widget.Marvel.CaptionBox"
        android:textSize="28sp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/arena3d"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/arena3d" />

    <!-- Cena da ultimate: tela escurece e entra o quadro do lutador com o nome do poder. -->
    <View
        android:id="@+id/ultimateScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="@color/scrim"
        android:clickable="false"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Linhas de ação na cor do golpe, por cima do escuro, só durante a cena da ultimate. -->
    <View
        android:id="@+id/ultimateLines"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/ultimatePanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_lg"
        android:background="@drawable/bg_narration"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ultimateImage"
            android:layout_width="@dimen/avatar_size_hero"
            android:layout_height="@dimen/avatar_size_hero"
            android:background="@drawable/bg_sticker"
            android:padding="@dimen/space_xs"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Marvel.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battle_ultimate"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/ultimateName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Resultado da luta num painel padrão (contorno e sombra dura, como os diálogos): título em
         explosão, confronto numa legenda, os números como os do Perfil e as conquistas num balão. Compartilhar = ícone no canto de cima,
         longe dos botões (tocava sem querer). -->
    <FrameLayout
        android:id="@+id/resultPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_lg"
        android:clipChildren="false"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/rematchButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title">

        <LinearLayout
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_dialog"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg">

            <!-- Troféu 3D (OpenGL), só na vitória. -->
            <com.projeto.marvel.ui.battle.TrophyView
                android:id="@+id/resultTrophy"
                android:layout_width="@dimen/trophy_size"
                android:layout_height="@dimen/trophy_size"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <TextView
                android:id="@+id/resultTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bebas_neue"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/resultVersus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Números, 3 por fileira (montados em código). -->
            <LinearLayout
                android:id="@+id/resultRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:clipChildren="false"
                android:orientation="vertical" />

            <!-- Conquistas desbloqueadas nesta luta (balão de fala). -->
            <TextView
                android:id="@+id/resultAchievements"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/shareResultButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_gravity="top|end"
            android:layout_marginEnd="@dimen/space_sm"
            android:background="@drawable/bg_share_bubble"
            android:contentDescription="@string/result_share_title"
            android:src="@drawable/ic_share"
            app:tint="@color/ink" />
    </FrameLayout>

    <!-- Confete da vitória, por cima de tudo (não recebe toque). -->
    <com.projeto.marvel.ui.battle.ConfettiView
        android:id="@+id/confetti"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/arena"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="arena3d,arenaBackdrop,cpuImage,cpuName,cpuHpBar,cpuEnergyBar,cpuHpText,cpuStatus,logText,playerImage,playerName,playerHpBar,playerEnergyBar,playerHpText,playerStatus" />

    <!-- Trilha do time antes de cada luta: onde você está, quem já caiu e o chefe no topo. -->
    <LinearLayout
        android:id="@+id/trailOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_screen"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="@dimen/space_lg"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/trailTitle"
            style="@style/Widget.Marvel.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ScrollView
            android:id="@+id/trailScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginVertical="@dimen/space_md"
            android:layout_weight="1">

            <com.projeto.marvel.ui.battle.TrailView
                android:id="@+id/trailView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/trailFightButton"
            style="@style/Widget.Marvel.ComicButton"
            android:layout_width="match_parent"
            android:text="@string/trail_fight" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/errorText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/space_lg"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- VS antes de cada luta (por cima de tudo). -->
    <include
        android:id="@+id/versus"
        layout="@layout/view_versus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
