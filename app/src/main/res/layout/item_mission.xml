<?xml version="1.0" encoding="utf-8"?>
<!-- Uma missão: o que fazer, barra de progresso, o pacote que paga e o botão de pegar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_sm"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/space_sm">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            tools:text="⚔️ Vença 3 batalhas" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            app:indicatorColor="@color/accent"
            app:indicatorTrackGapSize="0dp"
            app:trackColor="@color/surface_variant"
            app:trackCornerRadius="@dimen/space_xs"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="6dp" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="2/3 · prêmio: pacote Prata" />
    </LinearLayout>

    <TextView
        android:id="@+id/claim"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target"
        android:layout_marginStart="@dimen/space_sm"
        android:background="@drawable/bg_share_bubble"
        android:fontFamily="@font/bebas_neue"
        android:gravity="center"
        android:minWidth="@dimen/touch_target"
        android:paddingHorizontal="@dimen/space_md"
        android:textColor="@color/ink"
        android:textSize="16sp"
        tools:text="PEGAR" />
</LinearLayout>
