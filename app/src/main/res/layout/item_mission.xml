<?xml version="1.0" encoding="utf-8"?>
<!-- Uma missão no painel padrão (como os cards de Jogos): ícone, o que fazer, barra de progresso,
     o pacote que paga e o botão de pegar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_sm"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/space_md">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/mission_icon_size"
        android:layout_height="@dimen/mission_icon_size"
        android:layout_marginEnd="@dimen/space_md"
        android:background="@drawable/bg_circle"
        android:importantForAccessibility="no"
        android:padding="@dimen/space_sm"
        app:tint="@color/accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            tools:text="Hoje · Vença 3 batalhas" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/bar"
            style="@style/Widget.Marvel.HpBar"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_xs"
            app:indicatorColor="@color/accent" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="2/3 · prêmio: pacote Prata" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/claim"
        style="@style/Widget.Marvel.ComicButton"
        android:layout_width="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:minWidth="@dimen/touch_target"
        android:paddingHorizontal="@dimen/space_md"
        android:textSize="18sp"
        tools:text="PEGAR!" />
</LinearLayout>
