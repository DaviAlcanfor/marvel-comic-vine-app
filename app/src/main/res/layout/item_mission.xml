<?xml version="1.0" encoding="utf-8"?>
<!-- Um quadro da página de missões (MissionList.kt monta as tiras): arte de herói com HOJE/SEMANA
     e a onomatopeia da missão, o que fazer no letreiro, progresso em blocos de nanquim e o prêmio numa etiqueta do metal do
     pacote — ou "PEGAR!" numa explosão quando completa. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/mission_gutter"
    android:layout_weight="1"
    android:background="@drawable/bg_mission_panel"
    android:clipChildren="false"
    android:orientation="vertical"
    android:padding="@dimen/space_sm">

    <!-- Topo do quadro: a arte de um herói (cada missão a sua) com retícula, a plaquinha
         HOJE/SEMANA e a onomatopeia do tipo de missão (POW!, RIIIP!…), no lugar de um ícone. -->
    <!-- Recorta: a foto em centerCrop é maior que a área e vazaria por cima do título. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/mission_art_height"
        android:clipChildren="true"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface_variant"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_halftone" />

        <TextView
            android:id="@+id/kind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:background="@drawable/bg_caption"
            android:fontFamily="?attr/eraDisplayFont"
            android:paddingStart="@dimen/space_sm"
            android:paddingTop="2dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:rotation="-3"
            android:textColor="?attr/eraCaptionText"
            android:textSize="13sp"
            app:fontFamily="?attr/eraDisplayFont"
            tools:text="HOJE" />

        <TextView
            android:id="@+id/sfx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:importantForAccessibility="no"
            android:layout_margin="@dimen/space_xs"
            android:maxLines="1"
            android:rotation="-6"
            android:textSize="20sp"
            tools:text="POW!" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:fontFamily="?attr/eraDisplayFont"
        android:letterSpacing="0.03"
        android:textAllCaps="true"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        app:fontFamily="?attr/eraDisplayFont"
        tools:text="Vença 3 batalhas" />

    <!-- Empurra progresso e prêmio para o pé do quadro (quadros da tira com a mesma altura). -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Blocos do progresso (montados em código). -->
    <LinearLayout
        android:id="@+id/pips"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mission_pip_height"
        android:layout_marginTop="@dimen/space_sm"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        tools:text="2/3" />

    <!-- Prêmio (etiqueta no metal do pacote) ou PEGAR! (explosão) ou ✓ já pego. -->
    <TextView
        android:id="@+id/claim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:fontFamily="?attr/eraDisplayFont"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:minHeight="@dimen/mission_tag_height"
        android:paddingHorizontal="@dimen/space_sm"
        android:textColor="@color/ink"
        android:textSize="15sp"
        app:fontFamily="?attr/eraDisplayFont"
        tools:text="PRATA" />
</LinearLayout>
