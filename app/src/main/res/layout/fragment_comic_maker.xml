<?xml version="1.0" encoding="utf-8"?>
<!-- Monte sua HQ: página de 3 quadros (montados em código: herói, fundo, balão arrastável) e as
     ações de salvar e compartilhar. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_xl">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@android:color/transparent"
            android:contentDescription="@string/content_description_back"
            android:src="@drawable/ic_arrow_back" />

        <com.projeto.marvel.ui.LogoTextView
            style="@style/Widget.Marvel.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/comic_maker_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/comic_maker_hint"
            android:textColor="@color/text_secondary" />

        <!-- A página (é ela que vira imagem): papel com os quadros empilhados. -->
        <LinearLayout
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@color/comic_paper"
            android:orientation="vertical"
            android:padding="@dimen/space_sm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/saveButton"
                style="@style/Widget.Marvel.ComicButton.Secondary"
                android:layout_width="0dp"
                android:layout_marginEnd="@dimen/space_xs"
                android:layout_weight="1"
                android:text="@string/comic_maker_save" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/shareButton"
                style="@style/Widget.Marvel.ComicButton"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1"
                android:text="@string/comic_maker_share" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
