<?xml version="1.0" encoding="utf-8"?>
<!-- Super Trunfo: a sua carta (escolha o atributo) contra a da CPU (de costas até a rodada). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_xl">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@android:color/transparent"
            android:contentDescription="@string/content_description_back"
            android:src="@drawable/ic_arrow_back" />

        <com.projeto.marvel.ui.LogoTextView
            style="@style/Widget.Marvel.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trunfo_title" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/space_xl" />

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/game"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/score"
                style="@style/Widget.Marvel.CaptionBox"
                android:layout_marginTop="@dimen/space_sm" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal">

                <include
                    android:id="@+id/playerCard"
                    layout="@layout/view_trunfo_card" />

                <TextView
                    android:id="@+id/versus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginHorizontal="@dimen/space_xs"
                    android:fontFamily="?attr/eraSfxFont"
            app:fontFamily="?attr/eraSfxFont"
                    android:text="@string/trunfo_vs"
                    android:textColor="@color/primary"
                    android:textSize="22sp" />

                <include
                    android:id="@+id/cpuCard"
                    layout="@layout/view_trunfo_card" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/nextButton"
                style="@style/Widget.Marvel.ComicButton"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/trunfo_next"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
