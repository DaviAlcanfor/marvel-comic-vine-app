<?xml version="1.0" encoding="utf-8"?>
<!-- Uma linha da comparação: valor e barra de cada lado (a da esquerda cresce para a esquerda). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/space_xs">

    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="Ataque" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/leftValue"
            android:layout_width="@dimen/stat_value_width"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            tools:text="67" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/leftBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_xs"
            android:layout_weight="1"
            app:indicatorDirectionLinear="endToStart"
            app:indicatorTrackGapSize="0dp"
            app:trackColor="@color/surface_variant"
            app:trackCornerRadius="@dimen/space_xs"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="@dimen/hp_bar_height" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/rightBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            app:indicatorTrackGapSize="0dp"
            app:trackColor="@color/surface_variant"
            app:trackCornerRadius="@dimen/space_xs"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="@dimen/hp_bar_height" />

        <TextView
            android:id="@+id/rightValue"
            android:layout_width="@dimen/stat_value_width"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textStyle="bold"
            tools:text="54" />
    </LinearLayout>
</LinearLayout>
