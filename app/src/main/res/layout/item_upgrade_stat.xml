<?xml version="1.0" encoding="utf-8"?>
<!-- Uma linha do painel de melhorias: atributo, valor final (base + pontos) e os botões – / +.
     O valor tem largura fixa para os botões ficarem alinhados em todas as linhas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/space_xs">

    <TextView
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:drawablePadding="@dimen/space_sm"
        android:drawableTint="@color/text_secondary"
        android:gravity="center_vertical"
        android:textColor="@color/text_primary"
        tools:text="Ataque" />

    <TextView
        android:id="@+id/value"
        android:layout_width="@dimen/upgrade_value_width"
        android:gravity="end"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_sm"
        android:textColor="@color/accent"
        android:textStyle="bold"
        tools:text="62 (+6)" />

    <TextView
        android:id="@+id/minus"
        style="@style/Widget.Marvel.UpgradeButton"
        android:text="–" />

    <TextView
        android:id="@+id/plus"
        style="@style/Widget.Marvel.UpgradeButton"
        android:layout_marginStart="@dimen/space_xs"
        android:text="+" />
</LinearLayout>
