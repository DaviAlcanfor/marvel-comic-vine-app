<?xml version="1.0" encoding="utf-8"?>
<!-- "Quem disse?": o resumo do personagem num balão (nome escondido) e 4 opções. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_xl">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@android:color/transparent"
            android:contentDescription="@string/content_description_back"
            android:src="@drawable/ic_arrow_back" />

        <com.projeto.marvel.ui.LogoTextView
            style="@style/Widget.Marvel.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quote_title" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/space_xl" />

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/game"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/streak"
                style="@style/Widget.Marvel.CaptionBox"
                android:layout_marginTop="@dimen/space_sm" />

            <!-- A "fala": balão da época com o resumo (o nome vira ???). -->
            <TextView
                android:id="@+id/quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:lineSpacingExtra="2dp"
                android:minHeight="@dimen/quote_min_height"
                android:textSize="16sp" />

            <!-- Quem respondeu: o rosto aparece depois da escolha. -->
            <ImageView
                android:id="@+id/speaker"
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:layout_marginStart="@dimen/space_md"
                android:background="@drawable/bg_card"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:textColor="@color/accent_text"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/nextButton"
                style="@style/Widget.Marvel.ComicButton"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/guess_next"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
