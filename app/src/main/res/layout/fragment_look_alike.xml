<?xml version="1.0" encoding="utf-8"?>
<!-- "Com qual herói você parece?": foto (câmera ou galeria), análise da IA e o herói com o motivo. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_xl">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@android:color/transparent"
            android:contentDescription="@string/content_description_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/Widget.Marvel.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/look_alike_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/look_alike_intro"
            android:textColor="@color/text_secondary" />

        <ImageView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_card"
            android:clipToOutline="true"
            android:contentDescription="@string/look_alike_photo"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/cameraButton"
                style="@style/Widget.Marvel.ComicButton"
                android:layout_width="0dp"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:text="@string/look_alike_camera" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/galleryButton"
                style="@style/Widget.Marvel.ComicButton.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/look_alike_gallery" />
        </LinearLayout>

        <TextView
            android:id="@+id/analyzing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center"
            android:text="@string/look_alike_analyzing"
            android:textColor="@color/accent_text"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_md"
            android:visibility="gone">

            <!-- Você ≈ o herói: sua foto ao lado do card dele. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/yourPhoto"
                    style="@style/Widget.Marvel.LookAlikeCard"
                    android:contentDescription="@string/look_alike_photo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_sm"
                    android:fontFamily="@font/bebas_neue"
                    android:text="≈"
                    android:textColor="@color/accent_text"
                    android:textSize="40sp" />

                <ImageView
                    android:id="@+id/heroImage"
                    style="@style/Widget.Marvel.LookAlikeCard"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <TextView
                android:id="@+id/heroName"
                style="@style/Widget.Marvel.H2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                tools:text="Você parece o Doctor Strange!" />

            <TextView
                android:id="@+id/heroInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                tools:text="Stephen Strange · 5.202 aparições" />

            <!-- Semelhança -->
            <TextView
                android:id="@+id/matchText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:textColor="@color/accent_text"
                android:textStyle="bold"
                tools:text="87% parecido" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/matchBar"
                style="@style/Widget.Marvel.HpBar"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_xs"
                android:max="100" />

            <TextView
                android:id="@+id/traits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_primary"
                tools:text="• Pose de quem sabe o que faz\n• Capa? Não, mas o casaco ajuda" />

            <TextView
                android:id="@+id/reason"
                style="@style/Widget.Marvel.Narration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />

            <!-- Fala do herói para você (balão de HQ, posto em código). -->
            <TextView
                android:id="@+id/quote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="@dimen/space_md"
                android:textStyle="italic"
                tools:text="“Pelos anéis de Raggadorr, temos um mago aqui!”" />

            <TextView
                android:id="@+id/runnerUp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textColor="@color/text_secondary"
                tools:text="Quase deu: Iron Man" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/resultActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/openHero"
                style="@style/Widget.Marvel.ComicButton"
                android:layout_width="0dp"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:text="@string/look_alike_open" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/shareResult"
                style="@style/Widget.Marvel.ComicButton.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/look_alike_share" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
