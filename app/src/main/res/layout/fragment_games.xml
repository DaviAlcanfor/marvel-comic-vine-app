<?xml version="1.0" encoding="utf-8"?>
<!-- Aba Jogos: grade de capas (o jogo, o seu recorde e o "Jogar"); o "como jogar" abre no ⓘ. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xl">

        <com.projeto.marvel.ui.LogoTextView
            style="@style/Widget.Marvel.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_games" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/games_intro"
            android:textColor="@color/text_secondary" />

        <!-- Jogos em grade de 2 colunas (capa, recorde e Jogar); o "como jogar" fica no ⓘ. -->
        <GridLayout
            android:id="@+id/gamesGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:useDefaultMargins="false">

            <!-- Quem é esse herói? -->
            <LinearLayout
                android:id="@+id/guessCard"
                style="@style/Widget.Marvel.GameTile">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/game_banner_height">

                    <ImageView
                        android:id="@+id/guessBanner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/move_water"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_halftone" />

                    <TextView
                        android:id="@+id/guessCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="@dimen/space_md"
                        android:text="@string/guess_title"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Como jogar: num balão, para a capa ficar compacta na grade. -->
                    <ImageButton
                        android:id="@+id/guessInfo"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:layout_gravity="top|end"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/games_how_to"
                        android:src="@drawable/ic_info"
                        android:tag="@string/games_guess_how"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/guessRecord"
                    style="@style/Widget.Marvel.GameStat" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/guessPlay"
                    style="@style/Widget.Marvel.ComicButton"
                    android:layout_width="match_parent"
                    android:layout_margin="@dimen/space_md"
                    android:text="@string/games_play" />
            </LinearLayout>

            <!-- Com qual herói você parece? (aparência, IA) -->
            <LinearLayout
                android:id="@+id/lookCard"
                style="@style/Widget.Marvel.GameTile">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/game_banner_height">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/move_heal"
                        android:importantForAccessibility="no" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_halftone" />

                    <!-- Ícone do jogo: rosto na mira da câmera. -->
                    <ImageView
                        android:layout_width="@dimen/game_icon_size"
                        android:layout_height="@dimen/game_icon_size"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="@dimen/space_sm"
                        android:layout_marginEnd="@dimen/space_md"
                        android:importantForAccessibility="no"
                        android:rotation="-8"
                        android:src="@drawable/ic_face_scan"
                        app:tint="@color/ink" />

                    <TextView
                        android:id="@+id/lookCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="@dimen/space_md"
                        android:text="@string/look_alike_title"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Como jogar: num balão, para a capa ficar compacta na grade. -->
                    <ImageButton
                        android:id="@+id/lookInfo"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:layout_gravity="top|end"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/games_how_to"
                        android:src="@drawable/ic_info"
                        android:tag="@string/games_look_how"
                        app:tint="@color/white" />
                </FrameLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/lookPlay"
                    style="@style/Widget.Marvel.ComicButton"
                    android:layout_width="match_parent"
                    android:layout_margin="@dimen/space_md"
                    android:text="@string/games_play" />
            </LinearLayout>

            <!-- Que herói é você? -->
            <LinearLayout
                android:id="@+id/quizCard"
                style="@style/Widget.Marvel.GameTile">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/game_banner_height">

                    <ImageView
                        android:id="@+id/quizBanner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/move_magic"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_halftone" />

                    <TextView
                        android:id="@+id/quizCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="@dimen/space_md"
                        android:text="@string/home_quiz"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Como jogar: num balão, para a capa ficar compacta na grade. -->
                    <ImageButton
                        android:id="@+id/quizInfo"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:layout_gravity="top|end"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/games_how_to"
                        android:src="@drawable/ic_info"
                        android:tag="@string/games_quiz_how"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/quizRecord"
                    style="@style/Widget.Marvel.GameStat" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/quizPlay"
                    style="@style/Widget.Marvel.ComicButton"
                    android:layout_width="match_parent"
                    android:layout_margin="@dimen/space_md"
                    android:text="@string/games_play" />
            </LinearLayout>

            <!-- Super Trunfo (suas figurinhas contra a CPU) -->
            <LinearLayout
                android:id="@+id/trunfoCard"
                style="@style/Widget.Marvel.GameTile">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/game_banner_height">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/move_strike"
                        android:importantForAccessibility="no" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_halftone" />

                    <ImageView
                        android:layout_width="@dimen/game_icon_size"
                        android:layout_height="@dimen/game_icon_size"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_marginTop="@dimen/space_sm"
                        android:importantForAccessibility="no"
                        android:rotation="-8"
                        android:src="@drawable/nav_album"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/trunfoCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="@dimen/space_md"
                        android:text="@string/trunfo_title"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/trunfoInfo"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:layout_gravity="top|end"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/games_how_to"
                        android:src="@drawable/ic_info"
                        android:tag="@string/games_trunfo_how"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/trunfoRecord"
                    style="@style/Widget.Marvel.GameStat" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/trunfoPlay"
                    style="@style/Widget.Marvel.ComicButton"
                    android:layout_width="match_parent"
                    android:layout_margin="@dimen/space_md"
                    android:text="@string/games_play" />
            </LinearLayout>

            <!-- Jogo da Memória (pares de figurinhas) -->
            <LinearLayout
                android:id="@+id/memoryCard"
                style="@style/Widget.Marvel.GameTile">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/game_banner_height">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/move_magic"
                        android:importantForAccessibility="no" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_halftone" />

                    <ImageView
                        android:layout_width="@dimen/game_icon_size"
                        android:layout_height="@dimen/game_icon_size"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_marginTop="@dimen/space_sm"
                        android:importantForAccessibility="no"
                        android:rotation="-8"
                        android:src="@drawable/nav_games"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/memoryCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="@dimen/space_md"
                        android:text="@string/memory_title"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/memoryInfo"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:layout_gravity="top|end"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/games_how_to"
                        android:src="@drawable/ic_info"
                        android:tag="@string/games_memory_how"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/memoryRecord"
                    style="@style/Widget.Marvel.GameStat" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/memoryPlay"
                    style="@style/Widget.Marvel.ComicButton"
                    android:layout_width="match_parent"
                    android:layout_margin="@dimen/space_md"
                    android:text="@string/games_play" />
            </LinearLayout>

            <!-- Quem disse? (resumo com o nome escondido) -->
            <LinearLayout
                android:id="@+id/quoteCard"
                style="@style/Widget.Marvel.GameTile">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/game_banner_height">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/move_water"
                        android:importantForAccessibility="no" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_halftone" />

                    <ImageView
                        android:layout_width="@dimen/game_icon_size"
                        android:layout_height="@dimen/game_icon_size"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_marginTop="@dimen/space_sm"
                        android:importantForAccessibility="no"
                        android:rotation="-8"
                        android:src="@drawable/ic_search"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/quoteCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="@dimen/space_md"
                        android:text="@string/quote_title"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/quoteInfo"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:layout_gravity="top|end"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/games_how_to"
                        android:src="@drawable/ic_info"
                        android:tag="@string/games_quote_how"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/quoteRecord"
                    style="@style/Widget.Marvel.GameStat" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/quotePlay"
                    style="@style/Widget.Marvel.ComicButton"
                    android:layout_width="match_parent"
                    android:layout_margin="@dimen/space_md"
                    android:text="@string/games_play" />
            </LinearLayout>

            <!-- Monte sua HQ (3 quadros, falas e balões) -->
            <LinearLayout
                android:id="@+id/comicCard"
                style="@style/Widget.Marvel.GameTile">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/game_banner_height">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/move_blast"
                        android:importantForAccessibility="no" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_halftone" />

                    <ImageView
                        android:layout_width="@dimen/game_icon_size"
                        android:layout_height="@dimen/game_icon_size"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_marginTop="@dimen/space_sm"
                        android:importantForAccessibility="no"
                        android:rotation="-8"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/comicCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="@dimen/space_md"
                        android:text="@string/comic_maker_title"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/comicInfo"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:layout_gravity="top|end"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/games_how_to"
                        android:src="@drawable/ic_info"
                        android:tag="@string/games_comic_how"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/comicRecord"
                    style="@style/Widget.Marvel.GameStat" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/comicPlay"
                    style="@style/Widget.Marvel.ComicButton"
                    android:layout_width="match_parent"
                    android:layout_margin="@dimen/space_md"
                    android:text="@string/games_play" />
            </LinearLayout>
        </GridLayout>
    </LinearLayout>
</ScrollView>
