<?xml version="1.0" encoding="utf-8"?>
<!-- Cabeçalho do Álbum (primeira linha da grade): progresso, pacotes e missões. Fica dentro da
     grade para ela rolar sozinha e reciclar as figurinhas (antes as 255 eram montadas de uma vez). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_md">

    <!-- Progresso + ⓘ (as regras dos pacotes abrem num balão em vez de um parágrafo fixo). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/progress"
            style="@style/Widget.Marvel.CaptionBox" />

        <!-- Moderno: barra fina no lugar da legenda (AlbumFilterBar.applyEra). -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/surface_variant"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp" />

        <Space
            android:id="@+id/progressSpace"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/packsInfo"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/album_packs_info"
            android:src="@drawable/ic_info"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Pacotes: o desenho de cada um (Básico, Prata, Ouro) e quantos tem, no letreiro da época. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tileBasic"
            style="@style/Widget.Marvel.PackTile">

            <include
                android:id="@+id/packBasic"
                layout="@layout/view_pack"
                android:layout_width="@dimen/pack_small_width"
                android:layout_height="@dimen/pack_small_height" />

            <TextView
                android:id="@+id/countBasic"
                style="@style/Widget.Marvel.PackCount" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tileSilver"
            style="@style/Widget.Marvel.PackTile">

            <include
                android:id="@+id/packSilver"
                layout="@layout/view_pack"
                android:layout_width="@dimen/pack_small_width"
                android:layout_height="@dimen/pack_small_height" />

            <TextView
                android:id="@+id/countSilver"
                style="@style/Widget.Marvel.PackCount" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tileGold"
            style="@style/Widget.Marvel.PackTile">

            <include
                android:id="@+id/packGold"
                layout="@layout/view_pack"
                android:layout_width="@dimen/pack_small_width"
                android:layout_height="@dimen/pack_small_height" />

            <TextView
                android:id="@+id/countGold"
                style="@style/Widget.Marvel.PackCount" />
        </LinearLayout>
    </LinearLayout>

    <!-- Troca de repetidas por um Prata (desativado sem repetidas suficientes). Botão vermelho com
         texto branco na largura da grade: lê em todas as épocas, inclusive desativado. -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/tradeButton"
        style="@style/Widget.Marvel.ComicButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/trade_button_height"
        android:layout_marginTop="@dimen/space_sm"
        android:paddingHorizontal="@dimen/space_md"
        android:textSize="16sp" />

    <!-- Busca: "BUSCAR:" escrito (Retrô, Anos 90) ou a lupa (Moderno), e o campo. -->
    <LinearLayout
        android:id="@+id/searchBox"
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_md">

        <TextView
            android:id="@+id/searchLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_sm"
            android:importantForAccessibility="no"
            android:text="@string/album_search_label"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:drawablePadding="@dimen/space_sm"
            android:hint="@string/album_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />
    </LinearLayout>

    <!-- Atalhos de filtro e, no fim da fileira, a ordem (abre um menu). -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filterGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/sortChip"
                style="@style/Widget.Marvel.FilterChip"
                android:layout_marginStart="@dimen/space_sm"
                android:checkable="false"
                app:chipIcon="@drawable/ic_sort"
                app:chipIconTint="@color/filter_chip_text" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/filterCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

</LinearLayout>
