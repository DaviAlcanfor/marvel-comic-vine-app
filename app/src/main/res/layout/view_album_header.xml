<?xml version="1.0" encoding="utf-8"?>
<!-- Cabeçalho do Álbum (primeira linha da grade): progresso, pacotes e missões. Fica dentro da
     grade para ela rolar sozinha e reciclar as figurinhas (antes as 255 eram montadas de uma vez). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_md">

    <TextView
        android:id="@+id/progress"
        style="@style/Widget.Marvel.CaptionBox"
        android:layout_marginTop="@dimen/space_sm" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/album_packs_hint"
        android:textColor="@color/text_secondary" />

    <!-- Pacotes: Básico, Prata e Ouro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tileBasic"
            style="@style/Widget.Marvel.PackTile">

            <include
                android:id="@+id/packBasic"
                layout="@layout/view_pack"
                android:layout_width="@dimen/pack_small_width"
                android:layout_height="@dimen/pack_small_height" />

            <TextView
                android:id="@+id/countBasic"
                style="@style/Widget.Marvel.PackCount" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tileSilver"
            style="@style/Widget.Marvel.PackTile">

            <include
                android:id="@+id/packSilver"
                layout="@layout/view_pack"
                android:layout_width="@dimen/pack_small_width"
                android:layout_height="@dimen/pack_small_height" />

            <TextView
                android:id="@+id/countSilver"
                style="@style/Widget.Marvel.PackCount" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tileGold"
            style="@style/Widget.Marvel.PackTile">

            <include
                android:id="@+id/packGold"
                layout="@layout/view_pack"
                android:layout_width="@dimen/pack_small_width"
                android:layout_height="@dimen/pack_small_height" />

            <TextView
                android:id="@+id/countGold"
                style="@style/Widget.Marvel.PackCount" />
        </LinearLayout>
    </LinearLayout>

    <!-- Troca de repetidas por um Prata (desativado sem repetidas suficientes). -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/tradeButton"
        style="@style/Widget.Marvel.ComicButton"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_md" />

    <!-- Busca por nome + atalho de filtro + ordem: a grade abaixo mostra só o que passar. -->
    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_input"
        android:drawablePadding="@dimen/space_sm"
        android:drawableStart="@drawable/ic_search"
        android:hint="@string/album_search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/space_md"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filterGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sortGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/filterCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

</LinearLayout>
