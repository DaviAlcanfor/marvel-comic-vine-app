<?xml version="1.0" encoding="utf-8"?>
<!-- Tema de época (ThemeEra): os tokens que mudam entre Retrô, Anos 90 e Moderno. -->
<resources>
    <attr name="eraBackground" format="color" />
    <attr name="eraSurface" format="color" />
    <attr name="eraSurfaceVariant" format="color" />
    <attr name="eraBorder" format="color" />
    <attr name="eraTextSecondary" format="color" />
    <attr name="eraPrimary" format="color" />
    <attr name="eraPrimaryVariant" format="color" />
    <attr name="eraOverlay" format="color" />
    <attr name="eraScrim" format="color" />
    <attr name="eraSpeedLines" format="color" />
    <attr name="eraHalftone" format="color" />
    <attr name="eraScreen" format="reference" />
    <attr name="eraTitleFont" format="reference" />
    <attr name="eraTitleColor" format="color" />
    <attr name="eraTitleShadow" format="color" />
    <attr name="eraBodyFont" format="reference" />
    <attr name="eraDisplayFont" format="reference" />
    <attr name="eraSfxFont" format="reference" />
    <attr name="eraOutline" format="color" />
    <attr name="eraInkWidth" format="dimension" />
    <attr name="eraShadow" format="dimension" />
    <attr name="eraRadius" format="dimension" />
    <attr name="eraRadiusSmall" format="dimension" />
    <!-- 0 = Retrô, 1 = Anos 90, 2 = Moderno (ver Era em ui/Era.kt). -->
    <attr name="eraStyle" format="integer" />
    <attr name="eraCaptionText" format="color" />
    <attr name="eraNavActive" format="color" />
    <attr name="eraNavInactive" format="color" />
    <attr name="eraNavIndicator" format="color" />
    <attr name="eraChipShape" format="reference" />
    <attr name="eraChipFill" format="color" />
    <attr name="eraChipChecked" format="color" />
    <attr name="eraChipText" format="color" />
    <attr name="eraChipCheckedText" format="color" />
    <declare-styleable name="EraPanelDrawable">
        <attr name="panelKind" format="enum">
            <enum name="panel" value="0" />
            <enum name="button" value="1" />
            <enum name="secondary" value="2" />
            <enum name="caption" value="3" />
            <enum name="input" value="4" />
            <enum name="nav" value="5" />
        </attr>
        <attr name="panelFill" format="color" />
    </declare-styleable>
</resources>
