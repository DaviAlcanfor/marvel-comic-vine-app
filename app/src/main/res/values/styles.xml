<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tipografia do Design_System.svg. Estilos com fonte própria declaram android:fontFamily E
         fontFamily (AppCompat): o AppCompat lê primeiro o fontFamily do tema (Inter) e ignoraria
         o android:fontFamily do estilo. -->

    <!-- Display / Bebas Neue: títulos de tela ("MARVEL HEROES"). -->
    <!-- "Com qual herói você parece?": sua foto e o card do herói, lado a lado, em pé. -->
    <style name="Widget.Marvel.LookAlikeCard" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/look_alike_card_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <!-- Onomatopeia que estoura na tela de carregamento. -->
    <style name="Widget.Marvel.LoadingWord" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">?attr/eraDisplayFont</item>
        <item name="android:textSize">26sp</item>
        <item name="android:alpha">0</item>
    </style>

    <!-- Botão flutuante do Geek: bolha redonda. -->
    <style name="ShapeAppearance.Marvel.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Botão – / + do painel de melhorias da carta. -->
    <style name="Widget.Marvel.UpgradeButton" parent="">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Pacote no cabeçalho do Álbum: o desenho e a contagem embaixo. -->
    <style name="Widget.Marvel.PackTile" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clipChildren">false</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:paddingVertical">@dimen/space_xs</item>
    </style>

    <style name="Widget.Marvel.PackCount" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_sm</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <!-- Letreiro da época (Bangers / Bungee / Bebas), como os blocos do canvas. -->
        <item name="android:fontFamily">?attr/eraSfxFont</item>
        <item name="fontFamily">?attr/eraSfxFont</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Marvel.VersusName" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_sm</item>
        <item name="android:gravity">center</item>
        <!-- Estrelas numa linha e nome em até duas (Captain America cabe inteiro). -->
        <item name="android:maxLines">3</item>
        <item name="android:fontFamily">?attr/eraDisplayFont</item>
        <item name="fontFamily">?attr/eraDisplayFont</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <!-- Folga para o "VS" do meio não cobrir o nome. -->
        <item name="android:paddingHorizontal">@dimen/versus_name_inset</item>
    </style>

    <style name="Widget.Marvel.VersusSquad" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>


    <!-- Capa de jogo na aba Jogos: banner, como jogar, recorde e o botão. -->
    <style name="Widget.Marvel.GameCard" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_lg</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- Capa compacta na grade de 2 colunas da aba Jogos. -->
    <style name="Widget.Marvel.GameTile" parent="Widget.Marvel.GameCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill</item>
        <item name="android:layout_margin">@dimen/space_xs</item>
    </style>

    <style name="Widget.Marvel.GameText" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">@dimen/space_md</item>
        <item name="android:layout_marginTop">@dimen/space_md</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Widget.Marvel.GameStat" parent="Widget.Marvel.GameText">
        <item name="android:layout_marginTop">@dimen/space_sm</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Marvel.ScreenTitle" parent="">
        <item name="android:fontFamily">?attr/eraTitleFont</item>
        <item name="fontFamily">?attr/eraTitleFont</item>
        <item name="android:textSize">40sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">?attr/eraTitleColor</item>
        <!-- O letreiro dos Anos 90 (Bungee) é bem mais largo: encolhe até caber numa linha. -->
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">18sp</item>
        <item name="android:autoSizeMaxTextSize">40sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <!-- Letreiro de capa: sombra dura na cor da época (raio ~0 = sem desfoque). -->
        <item name="android:shadowColor">?attr/eraTitleShadow</item>
        <item name="android:shadowDx">3</item>
        <item name="android:shadowDy">3</item>
        <item name="android:shadowRadius">0.01</item>
    </style>

    <!-- H1 / Inter Bold 28 -->
    <style name="Widget.Marvel.H1" parent="">
        <item name="android:textSize">28sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- H2 / Inter SemiBold 20 -->
    <style name="Widget.Marvel.H2" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Body / Inter Regular 15 -->
    <style name="Widget.Marvel.Body" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Caption / Inter Medium 12, maiúsculas espaçadas ("HUMANO · MARVEL") -->
    <style name="Widget.Marvel.Caption" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Chip / tag de poder (não clicável): pílula surface_variant com borda. -->
    <style name="Widget.Marvel.Tag" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_tag</item>
        <item name="android:paddingHorizontal">@dimen/space_md</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- Busca recente na Home: mesma pílula da Tag, mas clicável e com X para remover. -->
    <style name="Widget.Marvel.RecentChip" parent="Widget.Material3.Chip.Input">
        <item name="chipBackgroundColor">@color/surface_variant</item>
        <item name="chipStrokeColor">@color/ink</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">100dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="closeIconTint">@color/text_secondary</item>
        <item name="chipIcon">@drawable/ic_search</item>
        <item name="chipIconTint">@color/text_secondary</item>
        <item name="chipIconVisible">true</item>
        <item name="android:checkable">false</item>
    </style>

    <!-- Card de favorito no Perfil (herói / série): imagem, rótulo e nome; clicável. -->
    <style name="Widget.Marvel.FavoriteCard" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/space_md</item>
    </style>

    <style name="Widget.Marvel.FavoriteImage" parent="">
        <item name="android:layout_width">@dimen/favorite_image_size</item>
        <item name="android:layout_height">@dimen/favorite_image_size</item>
        <item name="android:layout_marginBottom">@dimen/space_sm</item>
        <item name="android:background">@drawable/bg_circle</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <style name="Widget.Marvel.FavoriteName" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Filtro da estante por status (Já li / Lendo / Quero ler). -->
    <style name="Widget.Marvel.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="chipBackgroundColor">@color/filter_chip_background</item>
        <item name="chipStrokeColor">?attr/eraOutline</item>
        <item name="chipStrokeWidth">?attr/eraInkWidth</item>
        <item name="shapeAppearance">?attr/eraChipShape</item>
        <item name="android:textColor">@color/filter_chip_text</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Forma do chip por época: reto (Retrô), canto cortado (Anos 90), pílula (Moderno). -->
    <style name="ShapeAppearance.Marvel.Chip.Retro" parent="">
        <item name="cornerSize">0dp</item>
    </style>

    <style name="ShapeAppearance.Marvel.Chip.Nineties" parent="">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.Marvel.Chip.Modern" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Botão de status do diálogo da HQ/filme: mesmo visual do chip de filtro. -->
    <style name="Widget.Marvel.ToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="backgroundTint">@color/filter_chip_background</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="android:paddingStart">@dimen/space_xs</item>
        <item name="android:paddingEnd">@dimen/space_xs</item>
        <item name="strokeColor">@color/ink</item>
        <item name="strokeWidth">@dimen/ink_width</item>
    </style>

    <!-- Diálogos: título na fonte da época e botões em vermelho de texto; o fundo (bg_dialog) é posto em
         comicDialog(). Nada de amarelo como texto aqui: some no papel/branco do painel. -->
    <style name="ThemeOverlay.Marvel.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.Marvel.DialogTitle</item>
        <item name="colorPrimary">@color/primary_text</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_primary</item>
    </style>

    <style name="Widget.Marvel.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:fontFamily">?attr/eraDisplayFont</item>
        <item name="fontFamily">?attr/eraDisplayFont</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Biografia/descrição como caixa de narração de HQ: papel e texto de nanquim. -->
    <style name="Widget.Marvel.Narration" parent="Widget.Marvel.Body">
        <item name="android:background">@drawable/bg_narration</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_md</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingBottom">20dp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- Carrossel horizontal: vai até a borda da tela (margem negativa) mas o 1º card alinha com o
         conteúdo (padding igual + clipToPadding false). O card cortado fica na borda, não no meio. -->
    <style name="Widget.Marvel.Carousel" parent="">
        <item name="android:layout_marginStart">@dimen/carousel_bleed</item>
        <item name="android:layout_marginEnd">@dimen/carousel_bleed</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <!-- Barra de energia da ultimate: fina, na cor da magia (rosa), embaixo da vida. -->
    <style name="Widget.Marvel.EnergyBar" parent="Widget.Material3.LinearProgressIndicator">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_xs</item>
        <item name="android:max">100</item>
        <item name="trackThickness">@dimen/energy_bar_height</item>
        <item name="trackCornerRadius">@dimen/space_xs</item>
        <item name="indicatorColor">@color/move_magic</item>
        <item name="trackColor">@color/surface_variant</item>
        <!-- Sem o pontinho no fim do trilho nem o vão entre cheio e vazio (padrão do M3). -->
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="indicatorTrackGapSize">0dp</item>
    </style>

    <!-- Botão da ultimate: largo, vermelho, com o nome do poder. -->
    <style name="Widget.Marvel.UltimateButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:layout_marginBottom">@dimen/space_sm</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">?attr/eraDisplayFont</item>
        <item name="fontFamily">?attr/eraDisplayFont</item>
        <item name="android:textSize">20sp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/radius_small</item>
        <item name="strokeColor">@color/move_magic</item>
        <item name="strokeWidth">@dimen/ink_width</item>
    </style>

    <!-- Linha de números do Detalhe ("1.643 Aparições"): colunas iguais, valor em dourado. -->
    <style name="Widget.Marvel.Stat" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.Marvel.StatValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">?attr/eraDisplayFont</item>
        <item name="fontFamily">?attr/eraDisplayFont</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/accent_text</item>
    </style>

    <style name="Widget.Marvel.StatLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Barra inferior do Design_System.svg: fundo surface, ativo em dourado, sem "pílula" do M3. -->
    <style name="Widget.Marvel.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_nav</item>
        <!-- Sem o tint de surfaceContainer do M3, que deixava a barra rosada no tema claro. -->
        <item name="backgroundTint">@null</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Marvel.NavActive</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Marvel.BottomNav.ActiveIndicator</item>
        <!-- Retrô: o item ativo inteiro (ícone + nome) numa plaquinha amarela de nanquim. -->
        <item name="itemBackground">@drawable/bg_nav_item</item>
        <item name="itemRippleColor">@android:color/transparent</item>
    </style>

    <style name="TextAppearance.Marvel.NavActive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">?attr/eraDisplayFont</item>
        <item name="fontFamily">?attr/eraDisplayFont</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Abas (Descobrir): a ativa é uma plaquinha dourada de HQ, texto em Bebas. -->
    <style name="Widget.Marvel.Tabs" parent="Widget.Material3.TabLayout">
        <item name="android:background">@android:color/transparent</item>
        <item name="tabGravity">start</item>
        <item name="tabMode">scrollable</item>
        <!-- Esmaece a borda: mostra que há mais abas para o lado (Lugares fica fora da tela). -->
        <item name="android:requiresFadingEdge">horizontal</item>
        <item name="android:fadingEdgeLength">40dp</item>
        <item name="tabIndicator">@drawable/bg_tab_indicator</item>
        <!-- Transparente = o TabLayout não tinge o indicador (mantém dourado + nanquim). -->
        <item name="tabIndicatorColor">@android:color/transparent</item>
        <item name="tabIndicatorGravity">stretch</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabIndicatorAnimationMode">elastic</item>
        <item name="tabSelectedTextColor">@color/ink</item>
        <item name="tabTextColor">@color/text_secondary</item>
        <item name="tabTextAppearance">@style/TextAppearance.Marvel.Tab</item>
        <item name="tabRippleColor">@null</item>
        <item name="tabMinWidth">0dp</item>
        <!-- Recuo das telas; clipToPadding false: as abas rolam por baixo do recuo. -->
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:clipToPadding">false</item>
        <item name="tabPaddingStart">@dimen/space_md</item>
        <item name="tabPaddingEnd">@dimen/space_md</item>
    </style>

    <style name="TextAppearance.Marvel.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">?attr/eraDisplayFont</item>
        <item name="fontFamily">?attr/eraDisplayFont</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Retrô: plaquinha amarela reta atrás do item ativo; nas outras épocas, transparente. -->
    <style name="Widget.Marvel.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!-- Tema HQ ================================================================= -->

    <!-- Botão de HQ (AppCompatButton, não MaterialButton: o fundo é o drawable com sombra dura).
         Sem padding explícito: o padding vem do drawable e muda ao pressionar (a face "afunda"). -->
    <style name="Widget.Marvel.ComicButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:background">@drawable/bg_button_comic_primary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">?attr/eraDisplayFont</item>
        <item name="fontFamily">?attr/eraDisplayFont</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="Widget.Marvel.ComicButton.Secondary">
        <item name="android:background">@drawable/bg_button_comic_secondary</item>
        <item name="android:textColor">@color/accent_text</item>
    </style>

    <!-- Caixa de legenda de HQ: título de seção em dourado, levemente torto. -->
    <style name="Widget.Marvel.CaptionBox" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_caption</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:rotation">-2</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">?attr/eraCaptionFont</item>
        <item name="fontFamily">?attr/eraCaptionFont</item>
        <item name="android:textSize">?attr/eraCaptionSize</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">?attr/eraCaptionText</item>
    </style>

    <!-- Onomatopeia ("POW!") sobre BurstDrawable, posto em código. Espaço interno para os picos. -->
    <style name="Widget.Marvel.Onomatopoeia" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">28dp</item>
        <item name="android:paddingVertical">22dp</item>
        <item name="android:fontFamily">?attr/eraSfxFont</item>
        <item name="fontFamily">?attr/eraSfxFont</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:visibility">invisible</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="TextAppearance.Marvel.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textAllCaps">true</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- Estilos da arena de batalha (fragment_battle.xml). -->

    <style name="Widget.Marvel.MoveButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/move_button_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">?attr/eraDisplayFont</item>
        <item name="fontFamily">?attr/eraDisplayFont</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">@dimen/radius_small</item>
        <!-- A cor do contorno é a do tipo do golpe (posta em código); aqui só a espessura de HQ. -->
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">3dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">@dimen/space_xs</item>
    </style>

    <style name="Widget.Marvel.HpBar" parent="Widget.Material3.LinearProgressIndicator">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_sm</item>
        <item name="trackThickness">@dimen/hp_bar_height</item>
        <item name="trackCornerRadius">@dimen/space_xs</item>
        <item name="trackColor">@color/surface_variant</item>
        <item name="indicatorColor">@color/team_green</item>
        <!-- Sem o pontinho no fim do trilho nem o vão entre cheio e vazio (padrão do M3). -->
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="indicatorTrackGapSize">0dp</item>
    </style>

    <style name="Widget.Marvel.BattleCaption" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_xs</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Número de dano/cura que sobe e some sobre a foto do lutador: letra de HQ com sombra dura. -->
    <style name="Widget.Marvel.BattlePopup" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">?attr/eraSfxFont</item>
        <item name="fontFamily">?attr/eraSfxFont</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:shadowColor">@color/ink</item>
        <item name="android:shadowDx">3</item>
        <item name="android:shadowDy">3</item>
        <item name="android:shadowRadius">1</item>
        <item name="android:visibility">invisible</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
