<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Claro ("papel de gibi") e escuro (o do Design_System.svg): as cores vêm de values/colors.xml e
      values-night/colors.xml. Segue o sistema, ou o que o usuário fixar no Perfil (ThemeStore).
    -->
    <style name="Base.Theme.Marvel" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <!-- Ícones da barra de status/navegação escuros no tema claro. -->
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <!-- Inter como fonte padrão de todo texto; títulos usam Bebas Neue via Widget.Marvel.ScreenTitle. -->
        <item name="android:fontFamily">@font/era_body</item>
        <item name="fontFamily">@font/era_body</item>
        <!-- Botões: maiúsculas e semibold, como "ENTRAR" / "CRIAR CONTA" no Design System. -->
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Marvel.Button</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Marvel.Dialog</item>
        <!-- Tema de época: Retrô (claro) e Moderno (escuro) vêm de values/ e values-night/. -->
        <item name="eraBackground">@color/era_background</item>
        <item name="eraSurface">@color/era_surface</item>
        <item name="eraSurfaceVariant">@color/era_surface_variant</item>
        <item name="eraBorder">@color/era_border</item>
        <item name="eraTextSecondary">@color/era_text_secondary</item>
        <item name="eraPrimary">@color/era_primary</item>
        <item name="eraPrimaryVariant">@color/era_primary_variant</item>
        <item name="eraOverlay">@color/era_overlay</item>
        <item name="eraScrim">@color/era_scrim</item>
        <item name="eraSpeedLines">@color/era_speed_lines</item>
        <item name="eraHalftone">@color/era_halftone</item>
        <item name="eraScreen">@drawable/bg_era_screen</item>
        <item name="eraTitleFont">@font/era_title</item>
        <item name="eraTitleColor">@color/text_primary</item>
        <item name="eraTitleShadow">@color/era_primary</item>
        <item name="eraBodyFont">@font/era_body</item>
        <item name="eraDisplayFont">@font/era_display</item>
        <item name="eraSfxFont">@font/era_sfx</item>
        <item name="eraOutline">@color/era_outline</item>
        <item name="eraInkWidth">@dimen/era_ink_width</item>
        <item name="eraShadow">@dimen/era_shadow</item>
        <item name="eraRadius">@dimen/era_radius</item>
        <item name="eraRadiusSmall">@dimen/era_radius_small</item>
        <item name="eraStyle">@integer/era_style</item>
        <item name="eraCaptionText">@color/era_caption_text</item>
        <item name="eraNavActive">@color/era_nav_active</item>
        <item name="eraNavInactive">@color/era_nav_inactive</item>
        <item name="eraNavIndicator">@color/era_nav_indicator</item>
        <item name="eraChipShape">@style/ShapeAppearance.Marvel.Chip.Era</item>
        <item name="eraChipFill">@color/era_chip_fill</item>
        <item name="eraChipChecked">@color/era_chip_checked</item>
        <item name="eraChipText">@color/text_primary</item>
        <item name="eraChipCheckedText">@color/era_chip_checked_text</item>
    </style>

    <!--
      Anos 90 / 2000 (X-Men '92 e '97, Marvel Knights): aplicado por cima do tema escuro na
      MainActivity. Roxo profundo com azul-petróleo, magenta no lugar do vermelho e letreiro
      amarelo com "extrusão" azul.
    -->
    <style name="ThemeOverlay.Marvel.Nineties" parent="">
        <item name="eraBackground">@color/nineties_background</item>
        <item name="eraSurface">@color/nineties_surface</item>
        <item name="eraSurfaceVariant">@color/nineties_surface_variant</item>
        <item name="eraBorder">@color/nineties_border</item>
        <item name="eraTextSecondary">@color/nineties_text_secondary</item>
        <item name="eraPrimary">@color/nineties_primary</item>
        <item name="eraPrimaryVariant">@color/nineties_primary_variant</item>
        <item name="eraOverlay">@color/nineties_overlay</item>
        <item name="eraScrim">@color/nineties_background</item>
        <item name="eraSpeedLines">@color/nineties_speed_lines</item>
        <item name="eraHalftone">@color/nineties_halftone</item>
        <item name="eraScreen">@drawable/bg_nineties</item>
        <item name="eraTitleFont">@font/bungee</item>
        <item name="eraTitleColor">@color/accent</item>
        <item name="eraBodyFont">@font/barlow_condensed</item>
        <item name="eraDisplayFont">@font/barlow_condensed_bold_italic</item>
        <item name="eraSfxFont">@font/bungee</item>
        <item name="eraOutline">@color/nineties_outline</item>
        <item name="eraInkWidth">1.5dp</item>
        <item name="eraShadow">0dp</item>
        <item name="eraRadius">0dp</item>
        <item name="eraRadiusSmall">0dp</item>
        <item name="eraStyle">1</item>
        <item name="eraCaptionText">@color/white</item>
        <item name="eraNavActive">@color/logo_yellow</item>
        <item name="eraNavInactive">@color/nineties_outline</item>
        <item name="eraNavIndicator">@android:color/transparent</item>
        <item name="eraChipShape">@style/ShapeAppearance.Marvel.Chip.Nineties</item>
        <item name="eraChipFill">@color/nineties_input</item>
        <item name="eraChipChecked">@color/logo_yellow</item>
        <item name="eraChipText">@color/nineties_chip_text</item>
        <item name="eraChipCheckedText">@color/nineties_background</item>
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="fontFamily">@font/barlow_condensed</item>
        <item name="eraTitleShadow">@color/nineties_extrusion</item>
        <item name="android:statusBarColor">@color/nineties_background</item>
        <item name="android:navigationBarColor">@color/nineties_background</item>
    </style>

    <style name="Theme.Marvel" parent="Base.Theme.Marvel" />

    <!-- Splash: fundo escuro do app e o ícone; depois vira o tema normal (postSplashScreenTheme). -->
    <style name="Theme.Marvel.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/era_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.Marvel</item>
    </style>
</resources>
