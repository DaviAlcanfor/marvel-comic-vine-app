<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Design_System.svg só define um tema escuro (sem variante light), então o app
      fixa Material3 no modo dark em vez de herdar DayNight.
    -->
    <style name="Base.Theme.Marvel" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <!-- Inter como fonte padrão de todo texto; títulos usam Bebas Neue via Widget.Marvel.ScreenTitle. -->
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <!-- Botões: maiúsculas e semibold, como "ENTRAR" / "CRIAR CONTA" no Design System. -->
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Marvel.Button</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Marvel.Dialog</item>
    </style>

    <style name="Theme.Marvel" parent="Base.Theme.Marvel" />

    <!-- Splash: fundo escuro do app e o ícone; depois vira o tema normal (postSplashScreenTheme). -->
    <style name="Theme.Marvel.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.Marvel</item>
    </style>
</resources>
